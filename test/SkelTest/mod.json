{
  "id": "skeltest",
  "name": "SkelTest",
  "version": "0.0.0",
  "scope": "client",
  "dependsOn": [ { "id": "nucleus", "version": ">=0.9.0" } ],
  "settings": {
    "test.flag":   { "type": "bool", "default": false, "label": "A flag", "help": "Test only: on or off.", "changeable": "anytime" },
    "test.count":  { "type": "int", "default": 3, "min": 1, "max": 60, "label": "A count", "changeable": "anytime", "scope": "client" },
    "test.ratio":  { "type": "number", "default": 0.5, "min": 0, "max": 2, "step": 0.25, "label": "A ratio", "changeable": "anytime" },
    "test.mode":   { "type": "enum", "values": [ "a", "b", "c" ], "default": "a", "label": "A mode", "changeable": "menu" },
    "test.boot":   { "type": "int", "default": 10, "min": 0, "max": 100, "label": "Read at start", "changeable": "restart" },
    "test.lobby":  { "type": "bool", "default": false, "label": "Lobby only", "changeable": "lobby" },
    "test.preset": { "type": "number", "default": null, "min": 0, "max": 10, "label": "From a preset", "changeable": "menu", "source": "presets" }
  }
}
